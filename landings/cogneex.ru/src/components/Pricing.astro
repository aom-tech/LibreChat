---
import type { BillingPlansResponse, BillingPlan } from '../types/billing';

// Fetch pricing data at build time
let plans: BillingPlan[] = [];
let fetchError = false;

try {
  const response = await fetch('https://ai-courses-backend.aom-tech.ru/api/v1/billing/plans');
  const data: BillingPlansResponse = await response.json();
  
  if (data.success && data.activePlans) {
    plans = data.activePlans;
  } else {
    fetchError = true;
  }
} catch (error) {
  console.error('Failed to fetch billing plans:', error);
  fetchError = true;
}

// Separate plans by type
const subscriptionPlans = plans.filter(plan => plan.interval === 'monthly').sort((a, b) => a.price - b.price);
const oneTimePlans = plans.filter(plan => plan.interval === 'once').sort((a, b) => a.price - b.price);

// Format price with thousand separator
function formatPrice(price: number): string {
  return Math.floor(price / 100).toLocaleString('ru-RU');
}

// Format credits amount
function formatCredits(amount: number): string {
  if (amount >= 1000000) {
    return `${(amount / 1000000).toFixed(1).replace('.0', '')} млн`;
  } else if (amount >= 1000) {
    return `${(amount / 1000).toFixed(0).replace('.0', '')}k`;
  }
  return amount.toLocaleString('ru-RU');
}

// Get credit display name
function getCreditName(key: string, amount: number): string {
  const names: Record<string, string> = {
    text: amount >= 1000 ? 'токенов текста' : 'токенов',
    image: amount === 1 ? 'изображение' : 'изображений',
    presentation: amount === 1 ? 'презентация' : 'презентаций',
    video: 'секунд видео'
  };
  return names[key] || key;
}
---

<section id="pricing" class="section pricing">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Выберите ваш тариф</h2>
      <p class="section-subtitle">Прозрачные цены с оплатой картой РФ</p>
    </div>
    
    <div class="pricing-toggle">
      <button class="toggle-btn active" data-type="users">Пользователи</button>
      <button class="toggle-btn" data-type="business">Бизнес</button>
    </div>
    
    <div class="pricing-content">
      <!-- Пользователи -->
      <div class="pricing-cards" data-pricing="users">
        {fetchError ? (
          <!-- Fallback static content if API fails -->
          <div class="pricing-card">
            <div class="card-badge">Популярно</div>
            <h3 class="card-title">Базовый</h3>
            <div class="card-price">
              <span class="price">4 999</span>
              <span class="currency">₽/мес</span>
            </div>
            
            <ul class="card-features">
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span><strong>200 000</strong> токенов текста/мес</span>
              </li>
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span><strong>100</strong> изображений/мес</span>
              </li>
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span><strong>10</strong> презентаций/мес</span>
              </li>
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Все AI модели</span>
              </li>
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>API доступ</span>
              </li>
            </ul>
            
            <a href="#lead-form" class="btn btn-primary btn-block" data-form-type="b2c">Оформить подписку</a>
          </div>
        ) : (
          <>
            {/* Subscription Plans */}
            {subscriptionPlans.map((plan, index) => (
              <div class={`pricing-card ${index === 0 ? '' : 'premium'}`}>
                {index === 0 && <div class="card-badge">Популярно</div>}
                <h3 class="card-title">{plan.name}</h3>
                <div class="card-price">
                  <span class="price">{formatPrice(plan.price)}</span>
                  <span class="currency">₽/мес</span>
                </div>
                
                <ul class="card-features">
                  {/* Show main credits */}
                  {/* {Object.entries(plan.credits).filter(([_, amount]) => amount > 0).map(([key, amount]) => (
                    <li class={key === 'video' ? 'highlight' : ''}>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>
                        <strong>{key === 'video' ? amount / 200 : formatCredits(amount)}</strong> {getCreditName(key, key === 'video' ? amount / 200 : amount)}
                      </span>
                    </li>
                  ))} */}
                  
                  {/* Show metadata features */}
                  {plan.metadata.features.slice(0, 3).map((feature) => (
                    <li>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
                
                <a 
                  href={`https://coursegpt.cogneex.ru/subscriptions/buy/${plan._id}`} 
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`btn ${index === 0 ? 'btn-primary' : 'btn-secondary'} btn-block`}
                >
                  Оформить {plan.name}
                </a>
              </div>
            ))}
            
            {/* One-time Plans Section */}
            {oneTimePlans.length > 0 && (
              <div class="one-time-section">
                <h3 class="one-time-title">Разовые пакеты</h3>
                <div class="one-time-grid">
                  {oneTimePlans.map((plan) => {
                    const mainCredit = Object.entries(plan.credits).find(([_, amount]) => amount > 0);
                    const [creditKey, creditAmount] = mainCredit || ['', 0];
                    
                    return (
                      <div class="one-time-card">
                        <h4 class="one-time-card-title">{plan.name.replace('One time — ', '')}</h4>
                        <div class="one-time-price">
                          <span class="price-small">{formatPrice(plan.price)} ₽</span>
                        </div>
                        <p class="one-time-description">
                          {creditKey === 'video' 
                            ? `${creditAmount / 200} ${getCreditName(creditKey, creditAmount / 200)}`
                            : `${formatCredits(creditAmount)} ${getCreditName(creditKey, creditAmount)}`
                          }
                        </p>
                        <ul class="one-time-features">
                          {plan.metadata.features.map((feature) => (
                            <li>{feature}</li>
                          ))}
                        </ul>
                        <a 
                          href={`https://coursegpt.cogneex.ru/subscriptions/buy/${plan._id}`} 
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn btn-outline btn-small"
                        >
                          Купить
                        </a>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </>
        )}
      </div>
      
      <!-- Бизнес -->
      <div class="pricing-cards hidden" data-pricing="business">
        <div class="pricing-card business-card">
          <h3 class="card-title">Team/Pro</h3>
          <div class="card-price">
            <span class="price-text">По запросу</span>
          </div>
          
          <ul class="card-features">
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Гибкие квоты под ваши задачи</span>
            </li>
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Управление ролями и SSO</span>
            </li>
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>SLA и приоритетная поддержка</span>
            </li>
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>On-premise развертывание</span>
            </li>
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Выделенный менеджер</span>
            </li>
          </ul>
          
          <p class="business-note">
            💳 Оплата картой РФ, безнал по договору
          </p>
          
          <a href="#lead-form" class="btn btn-primary btn-block" data-form-type="b2b">Запросить коммерческое предложение</a>
        </div>
      </div>
    </div>
    
    <p class="pricing-note">
      * Все цены указаны с НДС. Возможна докупка дополнительных квот.
    </p>
  </div>
</section>

<style>
  .pricing {
    background: #f9fafb;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--gray);
  }

  .pricing-toggle {
    display: flex;
    justify-content: center;
    margin-bottom: 3rem;
    background: var(--white);
    border-radius: 0.75rem;
    padding: 0.25rem;
    max-width: 300px;
    margin-left: auto;
    margin-right: auto;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }

  .toggle-btn {
    flex: 1;
    padding: 0.75rem 1.5rem;
    background: transparent;
    border: none;
    border-radius: 0.5rem;
    font-weight: 600;
    color: var(--gray);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .toggle-btn.active {
    background: var(--primary);
    color: var(--white);
  }

  .pricing-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .pricing-cards.hidden {
    display: none;
  }

  .pricing-card {
    background: var(--white);
    border-radius: 1rem;
    padding: 2rem;
    position: relative;
    border: 2px solid #e5e7eb;
    transition: all 0.3s ease;
  }

  .pricing-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  .pricing-card.premium {
    border-color: var(--secondary);
  }

  .business-card {
    max-width: 500px;
    margin: 0 auto;
  }

  .card-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: var(--white);
    padding: 0.25rem 1rem;
    border-radius: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .card-title {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    text-align: center;
  }

  .card-price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .price {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--primary);
  }

  .currency {
    font-size: 1rem;
    color: var(--gray);
  }

  .price-text {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--dark);
  }

  .card-features {
    list-style: none;
    padding: 0;
    margin-bottom: 2rem;
  }

  .card-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid #f3f4f6;
  }

  .card-features li:last-child {
    border-bottom: none;
  }

  .card-features svg {
    color: var(--secondary);
    flex-shrink: 0;
  }

  .card-features .highlight {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(245, 158, 11, 0.1) 100%);
    margin: 0 -2rem;
    padding-left: 2rem;
    padding-right: 2rem;
    font-weight: 600;
  }

  /* One-time packages section */
  .one-time-section {
    grid-column: 1 / -1;
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 2px solid #e5e7eb;
  }

  .one-time-title {
    text-align: center;
    font-size: 1.75rem;
    margin-bottom: 2rem;
    color: var(--dark);
  }

  .one-time-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .one-time-card {
    background: var(--white);
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    transition: all 0.3s ease;
  }

  .one-time-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
  }

  .one-time-card-title {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
    color: var(--dark);
  }

  .one-time-price {
    margin-bottom: 0.5rem;
  }

  .price-small {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--primary);
  }

  .one-time-description {
    font-size: 0.875rem;
    color: var(--gray);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .one-time-features {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
    font-size: 0.8125rem;
    color: var(--gray);
  }

  .one-time-features li {
    padding: 0.25rem 0;
    line-height: 1.4;
  }

  .one-time-features li:before {
    content: "• ";
    color: var(--secondary);
    font-weight: bold;
  }

  .btn-outline {
    background: transparent;
    border: 2px solid var(--primary);
    color: var(--primary);
  }

  .btn-outline:hover {
    background: var(--primary);
    color: var(--white);
  }

  .btn-small {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .btn-block {
    width: 100%;
    justify-content: center;
  }

  .business-note {
    text-align: center;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--gray);
  }

  .pricing-note {
    text-align: center;
    margin-top: 2rem;
    font-size: 0.875rem;
    color: var(--gray);
  }

  @media (max-width: 767px) {
    .pricing-cards {
      grid-template-columns: 1fr;
    }
    
    .one-time-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const toggleBtns = document.querySelectorAll('.toggle-btn');
  const pricingContents = document.querySelectorAll('.pricing-cards');
  
  toggleBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const htmlBtn = btn as HTMLElement;
      const type = htmlBtn.dataset.type;
      
      toggleBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      pricingContents.forEach(content => {
        const htmlContent = content as HTMLElement;
        if (htmlContent.dataset.pricing === type) {
          content.classList.remove('hidden');
        } else {
          content.classList.add('hidden');
        }
      });
    });
  });
</script>